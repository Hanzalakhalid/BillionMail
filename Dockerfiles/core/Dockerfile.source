# syntax=docker/dockerfile:1
FROM node:22-alpine AS frontend
WORKDIR /frontend
COPY core/frontend/package.json core/frontend/pnpm-lock.yaml ./
RUN --mount=type=secret,id=host_ca \
    --mount=type=cache,target=/pnpm/store \
    if [ -s /run/secrets/host_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/host_ca; fi; \
    corepack enable && corepack prepare pnpm@10.28.2 --activate && \
    pnpm config set store-dir /pnpm/store && pnpm install --frozen-lockfile
COPY core/frontend/ ./
RUN pnpm run build

FROM golang:1.24-alpine AS backend
WORKDIR /src
COPY core/go.mod core/go.sum ./
RUN --mount=type=secret,id=host_ca \
    --mount=type=cache,target=/go/pkg/mod \
    if [ -s /run/secrets/host_ca ]; then export SSL_CERT_FILE=/run/secrets/host_ca; fi; \
    go mod download
COPY core/ ./
RUN --mount=type=secret,id=host_ca \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    if [ -s /run/secrets/host_ca ]; then export SSL_CERT_FILE=/run/secrets/host_ca; fi; \
    CGO_ENABLED=0 go build -trimpath -o /out/billionmail ./main.go && \
    CGO_ENABLED=0 go build -trimpath -o /out/saas-worker ./cmd/saas-worker && \
    CGO_ENABLED=0 go build -trimpath -o /out/scheduler ./cmd/scheduler

# Preserve the working mail management runtime and its entrypoint.
FROM billionmail/core:4.9.3
COPY --from=backend /out/ /opt/billionmail/core/
COPY --from=frontend /frontend/dist/ /opt/billionmail/core/public/dist/
COPY core/manifest/ /opt/billionmail/core/manifest/
COPY core/languages/ /opt/billionmail/core/languages/
COPY core/resource/ /opt/billionmail/core/resource/
COPY core/template/ /opt/billionmail/core/template/
